# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# --- Who the ads are for ---
# First name used in the sorting prompt.
CANDIDATE_NAME=
# Language of summaries and Telegram messages: en or fr
LANGUAGE=en
# Language of the dashboard: en or fr (also set with the globe button in the dashboard)
DASHBOARD_LANGUAGE=en

# --- AI used to sort the ads ---
# claude: Claude Code CLI with your Claude Pro/Max subscription (no key here)
# gemini: Gemini API with a key from https://aistudio.google.com/apikey
AI_PROVIDER=claude
GEMINI_API_KEY=
# Empty = gemini-flash-latest
GEMINI_MODEL=

# --- Telegram (required) ---
# Token given by @BotFather when you create your bot.
TELEGRAM_BOT_TOKEN=
# Your own chat id: write to your bot, then run  python -m jobalerts.telegram --whoami
TELEGRAM_CHAT_ID=

# --- What reaches Telegram ---
# Score 1-5 given by the AI. From MESSAGE_MIN_SCORE: one message per ad, with buttons.
# From DIGEST_MIN_SCORE up to MESSAGE_MIN_SCORE - 1: one short daily list.
MESSAGE_MIN_SCORE=4
DIGEST_MIN_SCORE=3
# Ads that require Norwegian: flag (send them with a flag) or reject (don't send them)
NORWEGIAN_REQUIRED=flag

# --- Search area (optional) ---
# Comma-separated, as written by NAV (Norwegian municipality and county names).
# Leave empty for the default: Oslo, Akershus, Drammen, Lier, Moss.
TARGET_MUNICIPALITIES=
TARGET_COUNTIES=

# --- NAV (optional) ---
# Empty = public token (fine to try). For long-term use, ask NAV for a private token:
# nav.team.arbeidsplassen@nav.no
NAV_TOKEN=

# --- Sources (true / false) ---
# NAV needs no setup. Finn and LinkedIn are read from their alert emails in Gmail (below).
SOURCE_NAV=true
SOURCE_FINN=true
SOURCE_LINKEDIN=false
# Optional Gmail label for the LinkedIn alerts (empty = INBOX).
GMAIL_LINKEDIN_LABEL=

# --- Finn alert emails via Gmail (optional) ---
# Gmail address that receives the Finn alerts, and a Gmail *app password* (not your normal password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional Gmail label to read instead of INBOX (e.g. finn-jobs).
GMAIL_FINN_LABEL=

# --- Finn ad pages (optional, OFF by default) ---
# Set to true ONLY if Finn gave YOU written permission to fetch the ad pages linked from your
# alert emails. Pages are fetched once per ad, in the daily run, 5 s apart.
FINN_FETCH_PAGES=false
# Required when FINN_FETCH_PAGES=true: sent in the User-Agent so Finn can identify the traffic.
FINN_CONTACT_EMAIL=
